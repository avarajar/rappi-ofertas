# Webhook de Discord al que se envia el reporte.
# Discord > Editar canal > Integraciones > Webhooks > Nuevo webhook > Copiar URL
# No hace falta para probar con --dry-run.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000/xxxxxxxx

# Pais de Rappi. Decide el dominio y se verifica contra lo que reporta la app.
# Opciones: co mx ar cl pe uy cr ec
# Brasil no esta: el sitio esta en portugues y los parsers solo entienden espanol.
RAPPI_COUNTRY=co

# Ciudad que debe estar seleccionada en la cuenta. El script se detiene si no coincide.
# Se usa para verificar (ignorando tildes) y tambien es lo que sale en el mensaje.
EXPECTED_ADDRESS=Chía

# Carpeta del perfil persistente de Chromium (sesion guardada).
BROWSER_PROFILE_DIR=.browser-profile

# Milisegundos maximos para la fase de scraping completa.
SCRAPE_TIMEOUT_MS=600000

# Tope de pasos de scroll infinito en el listado principal.
MAX_SCROLL_STEPS=40
